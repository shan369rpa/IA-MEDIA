rs\": {\n        \"conditions\": {\n          \"boolean\": [\n            {\n              \"value1\": \"\u003d{{ $(\u0027Merge Triggers\u0027).item.json.body.pusher }}\",\n              \"operation\": \"isNotEmpty\"\n            }\n          ]\n        }\n      },\n      \"name\": \"IF: Triggered by GitHub?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1120,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"values\": {\n          \"string\": [\n            {\n              \"name\": \"final_prompt\",\n              \"value\": \"\u003d{{ $(\u0027Get: System Message Template\u0027).item.json.data.replace(\u0027{{PROJECT_CONTEXT_CONTENT}}\u0027, $(\u0027Get: Project Context\u0027).item.json.data).replace(\u0027{{NOCODB_PROGRESS_REPORT}}\u0027, $(\u0027Format: Progress Report\u0027).item.json.report).replace(/\\\\*\\\\*\\\\*Part 3: Latest Code Commit.*\\\\*\\\\*\\\\*\\\\n.*\\\\n/s, \u0027\u0027) }}\"\n            }\n          ]\n        },\n        \"options\": {}\n      },\n      \"name\": \"Build: Prompt (no Commit)\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1340,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"values\": {\n          \"string\": [\n            {\n              \"name\": \"final_prompt\",\n              \"value\": \"\u003d{{ $(\u0027Get: System Message Template\u0027).item.json.data.replace(\u0027{{PROJECT_CONTEXT_CONTENT}}\u0027, $(\u0027Get: Project Context\u0027).item.json.data).replace(\u0027{{NOCODB_PROGRESS_REPORT}}\u0027, $(\u0027Format: Progress Report\u0027).item.json.report).replace(\u0027{{GITHUB_COMMIT_AUTHOR}}\u0027, $(\u0027Merge Triggers\u0027).item.json.body.pusher.name).replace(\u0027{{GITHUB_COMMIT_MESSAGE}}\u0027, $(\u0027Merge Triggers\u0027).item.json.body.head_commit.message).replace(\u0027{{GITHUB_COMMIT_URL}}\u0027, $(\u0027Merge Triggers\u0027).item.json.body.head_commit.url) }}\"\n            }\n          ]\n        },\n        \"options\": {}\n      },\n      \"name\": \"Build: Prompt (with Commit)\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1340,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"fileId\": \"YOUR_GOOGLE_DRIVE_FILE_ID\",\n        \"content\": \"\u003d{{ $(\u0027Build: Prompt (with Commit)\u0027).exists ? $(\u0027Build: Prompt (with Commit)\u0027).item.json.final_prompt : $(\u0027Build: Prompt (no Commit)\u0027).item.json.final_prompt }}\",\n        \"type\": \"text\"\n      },\n      \"name\": \"Update: Google Drive Memory\",\n      \"type\": \"n8n-nodes-base.googleDrive\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1580,\n        230\n      ],\n      \"credentials\": {\n        \"googleApi\": {\n          \"id\": \"YOUR_GOOGLE_CREDENTIAL_ID\",\n          \"name\": \"Google account\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"webhookUrl\": \"YOUR_DISCORD_WEBHOOK_URL\",\n        \"content\": \"✅ **AI Context Updated!**\\n\\nTriggered by: {{ $(\u0027IF: Triggered by GitHub?\u0027).item.json.output \u003d\u003d\u003d \u0027true\u0027 ? \u0027GitHub Push\u0027 : \u0027NocoDB Update\u0027 }}\\n\\nFile `IA_MEDIA_AI_CONTEXT.gdoc` has been updated and is ready for your next session.\",\n        \"options\": {}\n      },\n      \"name\": \"Notify: Discord\",\n      \"type\": \"n8n-nodes-base.discord\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1580,\n        370\n      ],\n      \"credentials\": {\n        \"discordWebhookApi\": {\n          \"id\": \"YOUR_DISCORD_WEBHOOK_CREDENTIAL_ID\",\n          \"name\": \"Discord webhook\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Trigger: GitHub Push\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Merge Triggers\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n      